<article>
  <h1><%= @city&.name %></h1>

  <ul class="menu">
    <% @locations.each do |loc| %>
      <li class="menu-item">
        <%= link_to loc.name, location_path(loc) %>
      </li>
    <% end %>

    <li class="menu-item">
      <%= link_to "Hunting", hunting_index_path %>
    </li>
  </ul>
</article>
